    {
      "id": "5QX4GNgYMwH2l_eFkkJZ0",
      "type": "text",
      "x": 610.8435648611785,
      "y": 1297.0826064564876,
      "width": 1061.988525390625,
      "height": 415.80000000000007,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
